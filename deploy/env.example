# Copy to /etc/contract-auditor.env on the server (setup-server.sh does this automatically).
# On Windows local dev, copy deploy/env.properties.example to C:\env.properties
# (run deploy/setup-local-env.ps1 as Administrator), or use C:/NewIdeas/env.properties
# with APP_ENV_FILE=C:/NewIdeas/env.properties.
# Replace YOUR_PUBLIC_IP_OR_DOMAIN with the VM public IP or domain name.

DB_URL=jdbc:mysql://localhost:3306/contract_auditor?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=contract_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://YOUR_PUBLIC_IP_OR_DOMAIN
FRONTEND_BASE_URL=http://YOUR_PUBLIC_IP_OR_DOMAIN
PASSWORD_RESET_EXPIRY_MINUTES=60

# Optional SMTP settings for password reset and renewal reminder emails.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

NOTIFICATION_CRON=0 0 8 * * *
