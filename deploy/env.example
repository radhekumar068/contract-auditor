# Copy to /etc/contract-auditor.env on the server (setup-server.sh does this automatically).
# On Windows local dev, copy deploy/env.properties.example to C:\env.properties
# (run deploy/setup-local-env.ps1 as Administrator), or use C:/NewIdeas/env.properties
# with APP_ENV_FILE=C:/NewIdeas/env.properties.
# Replace YOUR_DOMAIN with your HTTPS domain (or public IP if no domain).

DB_URL=jdbc:mysql://localhost:3306/contract_auditor?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=contract_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8081
SERVER_ADDRESS=127.0.0.1
SWAGGER_ENABLED=false
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN
FRONTEND_BASE_URL=https://YOUR_DOMAIN
PASSWORD_RESET_EXPIRY_MINUTES=60

# Optional SMTP settings for password reset and renewal reminder emails.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

NOTIFICATION_CRON=0 0 8 * * *

# Production logging (INFO in prod; DEBUG for service.impl is verbose)
LOGGING_LEVEL_CONTRACT_AUDITOR=INFO
LOGGING_LEVEL_SERVICE_IMPL=INFO

# Email discovery (disabled by default; set true only with all Google OAuth vars configured)
EMAIL_DISCOVERY_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/oauth/google/callback
EMAIL_TOKEN_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
