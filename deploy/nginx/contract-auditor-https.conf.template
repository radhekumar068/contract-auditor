# HTTP -> HTTPS redirect + ACME challenge for certificate renewal.
# Generated by deploy/install-nginx.sh — do not edit on the server.

server {
    listen 80;
    server_name __SERVER_NAME__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS application server (Phase 2 security headers + rate limiting).
server {
    listen 443 ssl http2;
    server_name __SERVER_NAME__;

    ssl_certificate __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    include snippets/contract-auditor-ssl-params.conf;

    include snippets/contract-auditor-security-headers.conf;
    include snippets/contract-auditor-security-headers-hsts.conf;
    include snippets/contract-auditor-locations.conf;
}
